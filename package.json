{
  "name": "@acedatacloud/n8n-nodes-qwen-image",
  "version": "0.1.0",
  "description": "Generate and edit Qwen Image pictures and retrieve their tasks in n8n through AceDataCloud.",
  "license": "MIT",
  "homepage": "https://github.com/AceDataCloud/QwenImageN8N",
  "keywords": [
    "n8n-community-node-package",
    "acedatacloud",
    "qwen-image",
    "image-generation",
    "image-editing"
  ],
  "author": {
    "name": "Ace Data Cloud",
    "email": "dev@acedata.cloud",
    "url": "https://platform.acedata.cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AceDataCloud/QwenImageN8N.git"
  },
  "bugs": {
    "url": "https://github.com/AceDataCloud/QwenImageN8N/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "test": "node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "files": [
    "dist/credentials",
    "dist/nodes",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/AceDataQwenImageApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/QwenImage/QwenImage.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.51.2",
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "eslint": "9.29.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
